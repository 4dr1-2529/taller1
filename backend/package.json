{
  "name": "backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "node scripts/railway-start.mjs",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:count-models": "node scripts/count-prisma-models.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:resolve-rolled-back": "prisma migrate resolve --rolled-back 20250604000000_init",
    "db:migrate:regenerate-init": "node scripts/regenerate-init-migration.mjs",
    "db:railway:fix-p3009": "node scripts/railway-fix-p3009.mjs",
    "db:push": "prisma db push",
    "db:seed": "npm run db:seed:structure",
    "db:seed:structure": "tsx prisma/seed.ts",
    "db:seed:prod": "node scripts/legacy-population-disabled.mjs",
    "db:seed:demo": "node scripts/legacy-population-disabled.mjs",
    "railway:seed:demo": "node scripts/legacy-population-disabled.mjs",
    "db:reset:demo": "node scripts/legacy-population-disabled.mjs",
    "db:reset:academic": "node scripts/legacy-population-disabled.mjs",
    "db:reset:full": "node scripts/legacy-population-disabled.mjs",
    "db:reseed": "node scripts/legacy-population-disabled.mjs",
    "db:demo-bcrypt": "node scripts/legacy-population-disabled.mjs",
    "db:update-passwords": "node scripts/legacy-population-disabled.mjs",
    "db:repair:all": "node scripts/legacy-population-disabled.mjs",
    "export:accounts": "node scripts/legacy-population-disabled.mjs",
    "export:accounts:prod": "node scripts/legacy-population-disabled.mjs",
    "export:accounts:web": "node scripts/legacy-population-disabled.mjs",
    "db:legacy-users": "node scripts/legacy-population-disabled.mjs",
    "test": "node --test tests/*.test.mjs && tsx --test tests/schemas.test.ts tests/teacher-scope.test.ts tests/validation-fields.test.ts tests/estudiante-scope.test.ts",
    "db:bootstrap": "npm run db:bootstrap:admin",
    "db:bootstrap:admin": "tsx prisma/bootstrap-admin.ts",
    "db:validate:preseed": "node scripts/validate-preseed-zero.mjs",
    "db:cleanup:preseed": "node scripts/preseed-cleanup-v2.mjs",
    "db:dataset:validate": "node scripts/validate-definitive-dataset-2026.mjs",
    "db:dataset:dry-run": "node scripts/import-definitive-dataset-2026.mjs --dry-run",
    "db:dataset:import": "node scripts/import-definitive-dataset-2026.mjs",
    "db:studio": "prisma studio",
    "type-check": "tsc --noEmit",
    "type-check:tools": "tsc -p tsconfig.tools.json",
    "test:integration": "tsx --test tests/refactor-2026.integration.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@tesis/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^6.3.1",
    "typescript": "^5",
    "xss": "^1.0.15",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20",
    "tsx": "^4.19.2"
  }
}
