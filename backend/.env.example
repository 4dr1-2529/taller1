# Copiar a backend/.env para desarrollo local
DATABASE_URL=mysql://root@localhost:3306/tesis_dashboard
JWT_SECRET=<GENERAR_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES>
# Contraseña demo institucional (seed, smoke tests, QA local)
DEMO_PASSWORD=

# URL del servicio FastAPI (machine-learning/).
# SOLO desarrollo: el default localhost:5000 funciona con `npm run dev`.
# PRODUCCIÓN (Railway): debe ser el dominio público real del servicio ML
# desplegado con machine-learning/Dockerfile, ej. ML_SERVICE_URL=https://<servicio-ml>.up.railway.app
# Sin una URL real el backend responde 503 en /predict: nunca convierte un fallo
# del ML en riesgo Bajo ni inventa predicciones.
ML_SERVICE_URL=http://localhost:5000
# Orígenes CORS de la API (coma). Producción: dominio de Vercel.
CORS_ORIGIN=http://localhost:3029
